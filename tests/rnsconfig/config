[reticulum]
  enable_transport = no
  share_instance = Yes
  instance_name = testrunner
#  shared_instance_port = 55905
#  instance_control_port = 55906
#  panic_on_interface_error = No
#  discoverable = yes

  enable_zone = yes
  zone_id = ffdcab81

  magic_00 = 7f7f
  magic_01 = "8e8e"
  magic_10 = 6d6d
  magic_11 = 0c0c
  

[logging]
  loglevel = 7

[interfaces]
  # No interfaces, only local traffic
    [[Default Interface]]
        type = AutoInterface
        enabled = no
    [[Client Interface]]
        type = TCPClientInterface
        enabled = yes
        mode = gateway
        target_host = 127.0.0.1
        target_port = 7822
        zone_default_allow = yes
        [[[zone_rules]]]
          [[[[ffdcab80]]]]
            accept_in = Yes
            accept_out = Yes
            hop_cost = yes
          [[[[ffdcab81]]]]
            accept_in = Yes
            accept_out = Yes
            hop_cost = yes

    [[Server Interface]]
        type = TCPServerInterface
        mode = boundary
        enabled = yes
        listen_ip = 0.0.0.0
        listen_port = 7822
        zone_default_allow = no
        [[[zone_rules]]]
          [[[[ffdcab80]]]]
            accept_in = Yes
            accept_out = Yes
            hop_cost = yes
          [[[[ffdcab82]]]]
            accept_out = Yes



            